# ---- Ops Hub environment variables ----
# Set these in Vercel: Project -> Settings -> Environment Variables

# Hosted Postgres (Neon recommended). Use the pooled connection string for serverless.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Secret used to HMAC-sign session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Email (Gmail app password). Leave unset for a graceful no-op (emails are logged, not sent).
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Optional: secret to protect the daily cron endpoint (Vercel sends this automatically if set).
CRON_SECRET=""

# Optional: the public base URL used in emailed links (defaults to request origin).
APP_URL=""
